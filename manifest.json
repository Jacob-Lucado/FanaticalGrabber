{
  "manifest_version": 3,
  "name": "FanaticalGrabber",
  "version": "2.5.0",
  "description": "Reveal, export and batch-redeem your game keys. Adds a Steam-style batch redeem panel on Steam.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://steamvaluechecker.fly.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.fanatical.com/*",
        "https://fanatical.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["steam.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://steamvaluechecker.fly.dev/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
