{
  "manifest_version": 3,
  "name": "FanaticalGrabber",
  "version": "2.12.0",
  "description": "Reveal, export and redeem Fanatical keys, check regions in one click, and compare prices with the free Steam Value Checker bot.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "cookies",
    "alarms"
  ],
  "action": {
    "default_title": "FanaticalGrabber",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://steamvaluechecker.com/*",
    "https://steamvaluechecker.fly.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.fanatical.com/*",
        "https://fanatical.com/*"
      ],
      "js": [
        "lib.js",
        "update.js",
        "stack.js",
        "content.js",
        "deals.js",
        "regions.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "update.js",
        "steam.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/account/history*"
      ],
      "js": [
        "history.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/account/licenses*"
      ],
      "js": [
        "licenses.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.humblebundle.com/store/*",
        "https://www.humblebundle.com/games/*",
        "https://www.gog.com/*",
        "https://store.epicgames.com/*",
        "https://www.greenmangaming.com/*"
      ],
      "js": [
        "theme.js",
        "stack.js",
        "stores.js",
        "regions.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.humblebundle.com/home/keys*",
        "https://www.humblebundle.com/downloads*"
      ],
      "js": [
        "lib.js",
        "humble.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamvaluechecker.com/*",
        "https://steamvaluechecker.fly.dev/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
